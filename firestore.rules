rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function meuPerfil() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function temPerfil() { return logado() && exists(meuPerfil()); }
    function papel() { return get(meuPerfil()).data.papel; }
    function liberado() { return temPerfil() && papel() in ['admin', 'gerente', 'financeiro', 'atendimento', 'equipe']; }
    function admin() { return temPerfil() && papel() == 'admin'; }
    function sistemaExiste() { return exists(/databases/$(database)/documents/config/sistema); }

    // Usuários: cada pessoa cria o próprio cadastro; só o administrador muda o tipo de acesso
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || liberado());
      allow create: if logado() && request.auth.uid == uid && (
        request.resource.data.papel == 'pendente' ||
        (request.resource.data.papel == 'admin' && !sistemaExiste())
      );
      allow update: if admin() || (logado() && request.auth.uid == uid && request.resource.data.papel == resource.data.papel);
      allow delete: if admin();
    }

    // Configurações da empresa
    match /config/{docId} {
      allow read: if liberado();
      allow create: if logado() && docId == 'sistema' && !sistemaExiste()
        && getAfter(meuPerfil()).data.papel == 'admin';
      allow update: if liberado() && papel() in ['admin', 'gerente'];
    }

    // Histórico de alterações
    match /logs/{id} {
      allow read: if admin();
      allow create: if liberado();
    }

    // Demais dados (clientes, OS, propostas, financeiro, equipes, serviços, contadores)
    match /{colecao}/{id} {
      allow read, write: if liberado() && !(colecao in ['usuarios', 'config', 'logs']);
    }
  }
}
